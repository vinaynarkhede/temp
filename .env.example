# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compute_marketplace
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=compute-jobs
MINIO_USE_SSL=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_LOG_LEVEL=info

# Coordinator Configuration
COORDINATOR_POLL_INTERVAL=5
COORDINATOR_NODE_TIMEOUT=90
COORDINATOR_MAX_RETRIES=3

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
BCRYPT_WORK_FACTOR=12

# Credit System
INITIAL_USER_CREDITS=100
CREDIT_WEIGHT_CPU_CORE=10
CREDIT_WEIGHT_RAM_GB=2

# Docker Security
DOCKER_CONTAINER_USER=1000:1000
DOCKER_PIDS_LIMIT=100

# Node Agent Configuration (for friend PCs)
NODE_NAME=my-node
NODE_API_KEY=your-api-key-here
COORDINATOR_URL=http://your-vps-ip:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE_API=logs/api.log
LOG_FILE_COORDINATOR=logs/coordinator.log
LOG_FILE_AGENT=logs/agent.log

# Environment
ENVIRONMENT=development
